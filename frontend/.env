# Environment Variables for Lizardfy
# PostgreSQL / Supabase connection URL
# Replace with your actual database connection string, e.g.:
# postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lizardfy?schema=public"

# Auth Secret for signing session JWT tokens
AUTH_SECRET="lizardfy_dev_secret_key_change_in_production_9876543210"
