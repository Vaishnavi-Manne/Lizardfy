# Environment Variables Template for Lizardfy
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lizardfy?schema=public"
AUTH_SECRET="your_long_random_jwt_secret_key"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth 2.0 Credentials
# Console: https://console.cloud.google.com/apis/credentials
# Authorized Redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Payment Configuration
# Supported Modes: 'sandbox' | 'razorpay_test' | 'razorpay_live'
PAYMENT_MODE="sandbox"

# Sandbox Payment Secret (Required when PAYMENT_MODE='sandbox', strictly server-side)
SANDBOX_PAYMENT_SECRET="your_sandbox_hmac_secret_key_minimum_32_characters"

# Razorpay Credentials (Required for 'razorpay_test' and 'razorpay_live')
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

